// Group for all TV stations
Group gWebTV "WebTV Sender" <screen>

// Control Elements / States
Player   WebTV_Control  "WebTV Steuerung"   <screen>
Dimmer   WebTV_Volume   "Lautstärke [%d %%]" <soundvolume>
Switch   WebTV_Mute     "Stummschaltung"     <soundvolume_mute>
String   WebTV_Sender   "Aktueller Sender"   <screen>
String   WebTV_Zap      "Sender zappen"      <screen>

// Channels with stream_uri metadata
Switch iWebTV_ARD "Das Erste" (gWebTV) { stream_uri="https://daserste-live.ard-mcdn.de/daserste/live/hls/de/master.m3u8" }
